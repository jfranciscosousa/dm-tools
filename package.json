{
  "name": "dm-tools",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:vercel": "pnpm dlx vercel env pull && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "ci": "pnpm run lint && pnpm run check && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright-testing-library/test": "^4.5.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/sanitize-html": "^2.16.1",
    "@types/showdown": "^2.0.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "daisyui": "^5.7.16",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.10.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.49",
    "ai": "7.0.62",
    "dexie": "^4.4.4",
    "dexie-observable": "4.0.1-beta.13",
    "encoding": "^0.1.13",
    "lodash-es": "^4.18.1",
    "sanitize-html": "^2.17.6",
    "showdown": "^2.1.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@12.0.0"
}
